EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat public SDK keys (Android: goog_..., iOS: appl_...)
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_android_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_key

# AI 키는 Supabase Edge Function Secrets에 저장 (앱 번들 비포함)
# supabase secrets set ANTHROPIC_API_KEY=... / OPENAI_API_KEY=...
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=your_google_tts_api_key
